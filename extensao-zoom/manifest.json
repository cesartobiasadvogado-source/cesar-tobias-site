{
  "manifest_version": 3,
  "name": "Vero Jurídico — Transcrição de Audiência",
  "version": "1.0.0",
  "description": "Grava o áudio da chamada (Zoom) e envia pra plataforma Vero Jurídico gerar a transcrição e o resumo da audiência.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "host_permissions": ["https://www.cesartobias.adv.br/*"]
}
