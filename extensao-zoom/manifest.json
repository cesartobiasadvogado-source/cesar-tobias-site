{
  "manifest_version": 3,
  "name": "Vero Jurídico — Transcrição de Audiência",
  "version": "1.7.1",
  "description": "Grava o áudio da chamada (Zoom ou Google Meet) e envia pra plataforma Vero Jurídico gerar a transcrição e o resumo da audiência.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "notifications"],
  "host_permissions": [
    "https://www.cesartobias.adv.br/*",
    "https://*.zoom.us/*", "https://app.zoom.us/*", "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zoom.us/wc/*", "https://*.zoom.us/j/*", "https://app.zoom.us/wc/*",
        "https://meet.google.com/*"
      ],
      "js": ["content_reuniao.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
